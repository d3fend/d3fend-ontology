@prefix : <http://d3fend.mitre.org/ontologies/d3fend.owl#> .
@prefix d3f: <http://d3fend.mitre.org/ontologies/d3fend.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://d3fend.mitre.org/ontologies/d3fend-bfo.owl#> rdf:type owl:Ontology ;
     owl:imports <../d3fend-protege.ttl#> ;
     owl:imports <http://purl.obolibrary.org/obo/bfo/2020/bfo-core.ttl> .


#
# Class Mappings
#
# BFO 2020 core is imported instead of the legacy OBO bfo.owl product so
# the BFO relations used below are also defined.

d3f:D3FENDCore rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> .
# BFO_0000001 is entity. D3FEND core classes cover continuants, occurrents, and dependent continuants.

d3f:D3FENDKBThing rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000031> .
# BFO_0000031 is generically dependent continuant. D3FEND KB things are reference and knowledge artifacts.

d3f:ExternalThing rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000031> .
# D3FEND external things are imported framework/control/model concepts represented as information artifacts.

d3f:Artifact rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000040> .
# BFO_0000040 is material entity. D3FEND artifacts are man-made objects taken as wholes.

d3f:DigitalArtifact rdfs:subClassOf [ rdf:type owl:Restriction ;
                                      owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000101> ;
                                      owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000031>
                                    ] .
# BFO_0000101 is "is carrier of". BFO_0000031 is generically dependent continuant.
# A digital artifact is treated as an information-bearing artifact without asserting
# equivalence to BFO's broader generically dependent continuant class.

d3f:System rdfs:subClassOf [ owl:intersectionOf ( <http://purl.obolibrary.org/obo/BFO_0000027>
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000178> ;
                                                    owl:someValuesFrom d3f:Artifact
                                                  ]
                                                ) ;
                             rdf:type owl:Class
                           ] .
# BFO_0000027 is object aggregate. BFO_0000178 is "has continuant part".
# A D3FEND system is an object aggregate with artifact parts.

d3f:Event owl:equivalentClass <http://purl.obolibrary.org/obo/BFO_0000015> .
# BFO_0000015 is process.

d3f:Action rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> .
# BFO has no direct "act" class in core; D3FEND actions are deliberate processes.

d3f:DigitalEvent rdfs:subClassOf [ owl:intersectionOf ( <http://purl.obolibrary.org/obo/BFO_0000015>
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000057> ;
                                                          owl:someValuesFrom d3f:DigitalArtifact
                                                        ]
                                                      ) ;
                                   rdf:type owl:Class
                                 ] .
# BFO_0000057 is "has participant". Digital events are processes with digital artifact participants.

d3f:Weakness rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000016> .
# BFO_0000016 is disposition.

d3f:Vulnerability rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000016> .
# A vulnerability is modeled as an exploitable disposition. The public-disclosure
# aspect of the D3FEND definition is not represented by BFO core.

d3f:Person rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000030> .
# BFO_0000030 is object. D3FEND persons are human beings.

d3f:Organization rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000027> .
# Organizations are treated as object aggregates in the BFO sense.

d3f:Plan rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000031> .
# Plans are treated as generically dependent continuants.

d3f:Goal rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000031> .
# Goals are treated as generically dependent continuants.

d3f:PhysicalLocation rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000029> .
# BFO_0000029 is site.

d3f:Time rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000008> .
# BFO_0000008 is temporal region.

d3f:TimeInstant owl:equivalentClass <http://purl.obolibrary.org/obo/BFO_0000203> .
# BFO_0000203 is temporal instant.

d3f:TimeInterval owl:equivalentClass <http://purl.obolibrary.org/obo/BFO_0000202> .
# BFO_0000202 is temporal interval.


#
# Property Mappings
#

d3f:contains rdfs:subPropertyOf <http://purl.obolibrary.org/obo/BFO_0000178> .
# BFO_0000178 is "has continuant part".

d3f:contained-by rdfs:subPropertyOf <http://purl.obolibrary.org/obo/BFO_0000176> .
# BFO_0000176 is "continuant part of".

d3f:has-participant rdfs:subPropertyOf <http://purl.obolibrary.org/obo/BFO_0000057> .
# BFO_0000057 is "has participant".

d3f:participates-in rdfs:subPropertyOf <http://purl.obolibrary.org/obo/BFO_0000056> .
# BFO_0000056 is "participates in".

d3f:precedes rdfs:subPropertyOf <http://purl.obolibrary.org/obo/BFO_0000063> .
# BFO_0000063 is "precedes".

d3f:preceded-by rdfs:subPropertyOf <http://purl.obolibrary.org/obo/BFO_0000062> .
# BFO_0000062 is "preceded by".

d3f:carries rdfs:subPropertyOf <http://purl.obolibrary.org/obo/BFO_0000101> .
# BFO_0000101 is "is carrier of".

d3f:carried-by rdfs:subPropertyOf <http://purl.obolibrary.org/obo/BFO_0000084> .
# BFO_0000084 is "generically depends on".

d3f:has-location rdfs:subPropertyOf <http://purl.obolibrary.org/obo/BFO_0000171> .
# BFO_0000171 is "located in".
