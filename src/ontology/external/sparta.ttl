:SPARTATactic a owl:Class ;
    rdfs:label "SPARTA Tactic" ;
    rdfs:subClassOf :SPARTAThing ;
    :definition "SPARTA Tactics represent the 'why' of a SPARTA technique. They denote the tactical goal of a threat actor and the reason for performing a technique." ;
    rdfs:seeAlso <https://sparta.aerospace.org/tactic/SPARTA> .

:SPARTATechnique a owl:Class ;
    rdfs:label "SPARTA Technique" ;
    rdfs:subClassOf :SPARTAThing ;
    :definition "SPARTA Techniques represent 'how' a threat actor achieves a tactical goal by performing a threat action." ;
    rdfs:seeAlso <https://sparta.aerospace.org/technique/SPARTA> .

:SPARTAThing a owl:Class ;
    rdfs:label "SPARTA Thing" ;
    rdfs:subClassOf :ExternalThreatModelThing .

:ST0001 a owl:Class,
        owl:NamedIndividual,
        :SPARTATactic ;
    rdfs:label "Reconnaissance - SPARTA" ;
    skos:prefLabel "Reconnaissance" ;
    rdfs:subClassOf :OffensiveTactic,
        :SPARTATactic ;
    :definition "Threat actor is trying to gather information they can use to plan future operations." ;
    :display-order 1 ;
    rdfs:seeAlso <https://sparta.aerospace.org/tactic/ST0001> .

:ST0002 a owl:Class,
        owl:NamedIndividual,
        :SPARTATactic ;
    rdfs:label "Resource Development - SPARTA" ;
    skos:prefLabel "Resource Development" ;
    rdfs:subClassOf :OffensiveTactic,
        :SPARTATactic ;
    :definition "Threat actor is trying to establish resources they can use to support operations." ;
    :display-order 2 ;
    rdfs:seeAlso <https://sparta.aerospace.org/tactic/ST0002> .

:ST0003 a owl:Class,
        owl:NamedIndividual,
        :SPARTATactic ;
    rdfs:label "Initial Access - SPARTA" ;
    skos:prefLabel "Initial Access" ;
    rdfs:subClassOf :OffensiveTactic,
        :SPARTATactic ;
    :definition "Threat actor is trying to get point of presence/command execution on the spacecraft." ;
    :display-order 3 ;
    rdfs:seeAlso <https://sparta.aerospace.org/tactic/ST0003> .

:ST0004 a owl:Class,
        owl:NamedIndividual,
        :SPARTATactic ;
    rdfs:label "Execution - SPARTA" ;
    skos:prefLabel "Execution" ;
    rdfs:subClassOf :OffensiveTactic,
        :SPARTATactic ;
    :definition "Threat actor is trying to execute malicious code on the spacecraft." ;
    :display-order 4 ;
    rdfs:seeAlso <https://sparta.aerospace.org/tactic/ST0004> .

:ST0005 a owl:Class,
        owl:NamedIndividual,
        :SPARTATactic ;
    rdfs:label "Persistence - SPARTA" ;
    skos:prefLabel "Persistence" ;
    rdfs:subClassOf :OffensiveTactic,
        :SPARTATactic ;
    :definition "Threat actor is trying to maintain their foothold/access to command/execute code on the spacecraft." ;
    :display-order 5 ;
    rdfs:seeAlso <https://sparta.aerospace.org/tactic/ST0005> .

:ST0006 a owl:Class,
        owl:NamedIndividual,
        :SPARTATactic ;
    rdfs:label "Defense Evasion - SPARTA" ;
    skos:prefLabel "Defense Evasion" ;
    rdfs:subClassOf :OffensiveTactic,
        :SPARTATactic ;
    :definition "Threat actor is trying to avoid being detected." ;
    :display-order 6 ;
    rdfs:seeAlso <https://sparta.aerospace.org/tactic/ST0006> .

:ST0007 a owl:Class,
        owl:NamedIndividual,
        :SPARTATactic ;
    rdfs:label "Lateral Movement - SPARTA" ;
    skos:prefLabel "Lateral Movement" ;
    rdfs:subClassOf :OffensiveTactic,
        :SPARTATactic ;
    :definition "Threat actor is trying to move through across sub-systems of the spacecraft." ;
    :display-order 7 ;
    rdfs:seeAlso <https://sparta.aerospace.org/tactic/ST0007> .

:ST0008 a owl:Class,
        owl:NamedIndividual,
        :SPARTATactic ;
    rdfs:label "Exfiltration - SPARTA" ;
    skos:prefLabel "Exfiltration" ;
    rdfs:subClassOf :OffensiveTactic,
        :SPARTATactic ;
    :definition "Threat actor is trying to steal information." ;
    :display-order 8 ;
    rdfs:seeAlso <https://sparta.aerospace.org/tactic/ST0008> .

:ST0009 a owl:Class,
        owl:NamedIndividual,
        :SPARTATactic ;
    rdfs:label "Impact - SPARTA" ;
    skos:prefLabel "Impact" ;
    rdfs:subClassOf :OffensiveTactic,
        :SPARTATactic ;
    :definition "Threat actor is trying to manipulate, interrupt, or destroy the space system(s) and/or data." ;
    :display-order 9 ;
    rdfs:seeAlso <https://sparta.aerospace.org/tactic/ST0009> .

