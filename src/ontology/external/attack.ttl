:TA0104 a :OffensiveTactic,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Execution - ATTACK ICS" ;
    skos:prefLabel "Execution" ;
    rdfs:subClassOf :ATTACKICSTactic,
        :OffensiveTactic .

:TA0105 a :OffensiveTactic,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Impact - ATTACK ICS" ;
    skos:prefLabel "Impact" ;
    rdfs:subClassOf :ATTACKICSTactic,
        :OffensiveTactic .

:TA0106 a :OffensiveTactic,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Impair Process Control - ATTACK ICS" ;
    skos:prefLabel "Impair Process Control" ;
    rdfs:subClassOf :ATTACKICSTactic,
        :OffensiveTactic .

:TA0107 a :OffensiveTactic,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Inhibit Response Function - ATTACK ICS" ;
    skos:prefLabel "Inhibit Response Function" ;
    rdfs:subClassOf :ATTACKICSTactic,
        :OffensiveTactic .

:TA0108 a :OffensiveTactic,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Initial Access - ATTACK ICS" ;
    skos:prefLabel "Initial Access" ;
    rdfs:subClassOf :ATTACKICSTactic,
        :OffensiveTactic .

:TA0109 a :OffensiveTactic,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Lateral Movement - ATTACK ICS" ;
    skos:prefLabel "Lateral Movement" ;
