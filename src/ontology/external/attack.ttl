    rdfs:subClassOf :ATTACKMobileTactic,
        :OffensiveTactic .

:TA0030 a :OffensiveTactic,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Defense Evasion - ATTACK Mobile" ;
