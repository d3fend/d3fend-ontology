:ATTACKThing a owl:Class ;
    rdfs:label "ATTACK Thing" ;
    rdfs:subClassOf :ExternalThreatModelThing ;
    :definition "ATTACK things are concepts defined in the ATT&CK Framework." .

:CollectionTechnique a owl:Class ;
    rdfs:label "Collection Technique" ;
    rdfs:subClassOf :ATTACKEnterpriseTechnique,
        :OffensiveTechnique,
        [ a owl:Restriction ;
            owl:onProperty :enables ;
            owl:someValuesFrom :TA0009 ] ;
    :definition "The adversary is trying to gather data of interest to their goal." .

:CommandAndControlTechnique a owl:Class ;
    rdfs:label "Command and Control Technique" ;
    rdfs:subClassOf :ATTACKEnterpriseTechnique,
        :OffensiveTechnique,
        [ a owl:Restriction ;
            owl:onProperty :enables ;
            owl:someValuesFrom :TA0011 ] ;
    :definition "The adversary is trying to communicate with compromised systems to control them." .

:CredentialAccessTechnique a owl:Class ;
    rdfs:label "Credential Access Technique" ;
    rdfs:subClassOf :ATTACKEnterpriseTechnique,
        :OffensiveTechnique,
        [ a owl:Restriction ;
            owl:onProperty :accesses ;
            owl:someValuesFrom :Credential ],
        [ a owl:Restriction ;
            owl:onProperty :enables ;
            owl:someValuesFrom :TA0006 ],
        [ a owl:Restriction ;
            owl:onProperty :may-access ;
            owl:someValuesFrom :PasswordFile ],
        [ a owl:Restriction ;
            owl:onProperty :may-invoke ;
            owl:someValuesFrom :CreateProcess ] .

:DefenseEvasionTechnique a owl:Class ;
    owl:deprecated true ;
    rdfs:label "Defense Evasion Technique" ;
    rdfs:subClassOf :ATTACKEnterpriseTechnique,
        :OffensiveTechnique,
        [ a owl:Restriction ;
            owl:onProperty :enables ;
            owl:someValuesFrom :TA0005 ] ;
    rdfs:comment "This ATT&CK tactic class was superseded in ATT&CK v19.0 by StealthTechnique and DefenseImpairmentTechnique." ;
    :definition "The adversary is trying to avoid being detected." .

