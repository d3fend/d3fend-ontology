    rdfs:subClassOf :ATTACKMobileTactic,
        :OffensiveTactic .

:TA0031 a :OffensiveTactic,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Credential Access - ATTACK Mobile" ;
