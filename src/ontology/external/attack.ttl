    rdfs:subClassOf :ATTACKEnterpriseTechnique,
        :OffensiveTechnique,
        [ a owl:Restriction ;
            owl:onProperty :enables ;
            owl:someValuesFrom :TA0112 ] ;
    :definition "The adversary is trying to break security mechanisms, pipelines, and tooling so defenders can’t see or trust what’s happening." .

:DiscoveryTechnique a owl:Class ;
