    rdfs:subClassOf :ATLASTechnique,
        [ a owl:Restriction ;
            owl:onProperty :enables ;
            owl:someValuesFrom :AML.TA0007 ] .

:ATLASDiscoveryTechnique a owl:Class ;
    rdfs:label "Discovery Technique - ATLAS" ;
    skos:prefLabel "Discovery Technique" ;
    rdfs:subClassOf :ATLASTechnique,
        [ a owl:Restriction ;
            owl:onProperty :enables ;
            owl:someValuesFrom :AML.TA0008 ] .

:ATLASExecutionTechnique a owl:Class ;
    rdfs:label "Execution Technique - ATLAS" ;
    skos:prefLabel "Execution Technique" ;
    rdfs:subClassOf :ATLASTechnique,
        [ a owl:Restriction ;
            owl:onProperty :enables ;
            owl:someValuesFrom :AML.TA0005 ] .

:ATLASExfiltrationTechnique a owl:Class ;
    rdfs:label "Exfiltration Technique - ATLAS" ;
    skos:prefLabel "Exfiltration Technique" ;
    rdfs:subClassOf :ATLASTechnique,
        [ a owl:Restriction ;
            owl:onProperty :enables ;
            owl:someValuesFrom :AML.TA0010 ] .

:ATLASImpactTechnique a owl:Class ;
    rdfs:label "Impact Technique - ATLAS" ;
    skos:prefLabel "Impact Technique" ;
    rdfs:subClassOf :ATLASTechnique,
        [ a owl:Restriction ;
            owl:onProperty :enables ;
            owl:someValuesFrom :AML.TA0011 ] .

:ATLASInitialAccessTechnique a owl:Class ;
    rdfs:label "Initial Access Technique - ATLAS" ;
    skos:prefLabel "Initial Access Technique" ;
    rdfs:subClassOf :ATLASTechnique,
        [ a owl:Restriction ;
            owl:onProperty :enables ;
            owl:someValuesFrom :AML.TA0004 ] .

:ATLASLateralMovementTechnique a owl:Class ;
    rdfs:label "Lateral Movement Technique - ATLAS" ;
    skos:prefLabel "Lateral Movement Technique" ;
    rdfs:subClassOf :ATLASTechnique,
        [ a owl:Restriction ;
            owl:onProperty :enables ;
            owl:someValuesFrom :AML.TA0015 ] .

:ATLASPersistenceTechnique a owl:Class ;
    rdfs:label "Persistence Technique - ATLAS" ;
    skos:prefLabel "Persistence Technique" ;
    rdfs:subClassOf :ATLASTechnique,
        [ a owl:Restriction ;
            owl:onProperty :enables ;
